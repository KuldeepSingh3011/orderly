# Multi-stage build for all Java services
# Build from project root: docker build -f Dockerfile.services .

FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app

# Copy the entire project for multi-module build
COPY pom.xml .
COPY common-lib ./common-lib
COPY auth-service ./auth-service
COPY order-service ./order-service
COPY inventory-service ./inventory-service
COPY notification-service ./notification-service
COPY recommendation-service ./recommendation-service

# Build all modules
RUN mvn clean package -DskipTests

# Verify JAR files were created (list all JARs for debugging)
RUN echo "=== Checking JAR files ===" && \
    ls -la /app/*/target/*.jar || echo "No JAR files found" && \
    find /app -name "*.jar" -type f || echo "JAR search failed"

# ============ Auth Service ============
FROM eclipse-temurin:17-jre AS auth-service
WORKDIR /app
# Copy all JARs and select the service JAR
COPY --from=builder /app/auth-service/target/*.jar /tmp/
RUN mv /tmp/auth-service-*.jar app.jar 2>/dev/null || \
    mv /tmp/*.jar app.jar || \
    (echo "ERROR: No JAR file found!" && ls -la /tmp/ && exit 1)
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8085/actuator/health || exit 1
EXPOSE 8085
ENTRYPOINT ["java", "-jar", "app.jar"]

